# =============================================================================
# Knowledge Hub OS - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values. Never commit the real .env.

# --- Database (Neon Postgres + PgBouncer pooler) ---
DATABASE_URL='postgresql://user:password@your-host.neon.tech/neondb?sslmode=require&pgbouncer=true'

# --- MongoDB (AI insights store) ---
MONGO_URI='mongodb+srv://user:password@cluster.mongodb.net/?appName=YourApp'

# --- Google Gemini AI ---
GEMINI_API_KEY='your-gemini-api-key-here'

# --- JWT (REQUIRED — no fallback in production) ---
JWT_SECRET='generate-a-strong-random-secret-here'
JWT_EXPIRES_IN='1d'

# --- Kafka ---
# Leave empty or set to 'disabled' to use HTTP fallback mode
KAFKA_BROKER_URL=''
# KAFKA_SASL_USERNAME=''
# KAFKA_SASL_PASSWORD=''

# --- Redis (JWT Blacklist) ---
REDIS_URL='redis://localhost:6379'

# --- Service Ports ---
PORT_API_GATEWAY=3000
PORT_AUTH_SERVICE=3001
PORT_GOAL_SERVICE=3002
PORT_AI_SERVICE=8000
PORT_FRONTEND=4000

# --- CORS (comma-separated list of allowed origins) ---
ALLOWED_ORIGINS='http://localhost:4000'

# --- Service URLs (consumed by Next.js frontend & proxy) ---
NEXT_PUBLIC_API_GATEWAY_URL='http://localhost:3000'
NEXT_PUBLIC_AUTH_URL='http://localhost:3001'
NEXT_PUBLIC_GOAL_SERVICE_URL='http://localhost:3002'
NEXT_PUBLIC_AI_SERVICE_URL='http://localhost:8000'

# --- Internal service-to-service URL (Docker/prod only) ---
# AI_SERVICE_INTERNAL_URL='http://ai-service:8000'
