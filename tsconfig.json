{
    "compilerOptions": {
        "module": "CommonJS",
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "target": "ES2022",
        "sourceMap": true,
        "incremental": true,
        "outDir": "./dist",
        "baseUrl": "./",
        "paths": {
            "@libs/*": [
                "libs/*"
            ]
        },
        "strict": true,
        "lib": [
            "ES2022"
        ],
        "skipLibCheck": true,
        "esModuleInterop": true
    }
}